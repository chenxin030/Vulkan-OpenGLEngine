# ---------------------------------------------------------------------------
# 这个文件解决编码问题，而且只需要修一次。但**规则是按文件类型分的，不是全局的**。
#
# ---------------------------------------------------------------------------
# 默认：UTF-8 **不带** BOM。
#
# 为什么默认不带 —— 判据是「读这个文件的解析器认不认 BOM」，而大多数非编译器
# 工具都不认。
#
# 已经踩过的具体案例：**glslc / glslang 不认 GLSL 里的 BOM。**
# GLSL 规范要求 #version 必须出现在最前面（只允许注释和空白），BOM 不是空白 ——
# 于是 glslc 以为文件没有版本声明，回退到 GLSL 1.10，然后报：
#
#     error : #version: Desktop shaders for Vulkan SPIR-V require version 140 or higher
#
# 而文件里明明写着 #version 450。报错和眼睛看到的完全对不上，因为它抱怨的是
# 「它没看见」的那一行。
#
# ⚠️ 这个 [*] 曾经写成 utf-8-bom，把 shader 也带上了 —— 那是个错。
#    **"一份规则适用于所有文件"在编码这件事上不成立。**
# ---------------------------------------------------------------------------
[*]
charset = utf-8
insert_final_newline = true

# ---------------------------------------------------------------------------
# 只有 C++ 源文件带 BOM。
#
# 理由是它对面那个问题：中文 Windows 上 VS 默认按 ANSI（GBK / 代码页 936）保存，
# 而 CMakeLists 里加了 /utf-8 —— 两边对不上。后果由轻到重：
#   1. 中文注释变乱码，或报警告 C4828
#   2. GBK 双字节字符的**尾字节可能是 0x5C（反斜杠 `\`）**。反斜杠出现在行尾会
#      触发**续行** —— 把下一行代码吞进注释里。**而编译器一声不吭。**
#
# 带 BOM 的文件，VS 下次能可靠认出它是 UTF-8，不会再偷偷存回 GBK。
# 而 MSVC 的 /utf-8 对带不带 BOM 都认 —— 这是"防止复发"和"能编译"同时成立的
# 那个选项，**但它只对 C++ 成立。**
# ---------------------------------------------------------------------------
[*.{h,hpp,cpp,cc,inl}]
charset = utf-8-bom

# ---------------------------------------------------------------------------
# 故意**没有**在这里写的两件事，以及为什么：
#
#   end_of_line  —— 统一行尾（LF）。但现在已有文件的行尾并不统一（VS 建的文件
#                   可能是 CRLF，我写的那些是 LF）。一旦在这里定死，下次保存会把
#                   某个文件整篇"看起来全改了"，而那份 diff 里没有一个逻辑改动。
#                   **这违反 docs/04 §7 那条纪律：格式化和重排不许混进逻辑改动。**
#                   正确做法：等一个阶段写完、功能全通了，单独做一次并单独提交。
#
#   indent_style / indent_size —— 同理。而且 `vulkanTools.h` 用的是**制表符**、
#                   `vulkanTools.cpp` 用的是**4 个空格**，两者不统一。这也要等那次
#                   单独的整理一起做。
#
# **一次只动一个变量。** 编码那条已经落地了，别的都往后放。
# ---------------------------------------------------------------------------
